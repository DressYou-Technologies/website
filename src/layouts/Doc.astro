---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Finale from '../components/Finale.astro';
import GetDialog from '../components/GetDialog.astro';
import { COPY } from '../i18n/copy';
import type { Lang } from '../i18n/lang';

interface Props { lang: Lang; title: string; path: string; updated?: string; noindex?: boolean; nofollow?: boolean }
const { lang, title, path, updated, noindex = false, nofollow = false } = Astro.props;
const t = COPY[lang].doc;
---
<Base lang={lang} path={path} title={`${title} · DressYou`} noindex={noindex} nofollow={nofollow}>
  <Header lang={lang} path={path} />
  <main>
    <section class="band" data-tone="dark"><h1>{title}</h1>{updated && <p>{t.updated} {updated}</p>}</section>
    <article class="doc"><slot /></article>
  </main>
  <Finale lang={lang} path={path} />
  <GetDialog lang={lang} />
</Base>

<script>
  import { startChrome } from '../scripts/chrome';
  startChrome();
</script>

<style>
  /* The header is white, so the page opens on the site's dark band, as the home page does. */
  .band { margin: 12px; padding: clamp(120px, 16vw, 180px) clamp(20px, 4vw, 56px) clamp(40px, 6vw, 72px); border-radius: 28px; background: radial-gradient(120% 90% at 50% 0%, #2a2a2a 0%, #0b0b0b 55%, #000 100%); color: #fff; }
  h1 { margin: 0; font-size: clamp(2.5rem, 6vw, 4.5rem); font-weight: 700; letter-spacing: -.055em; line-height: 1; }
  .band p { margin: 16px 0 0; color: #a1a1a1; font-family: var(--font-mono); font-size: 12px; letter-spacing: .16em; text-transform: uppercase; }
  .doc { max-width: 720px; margin: 0 auto; padding: clamp(40px, 6vw, 72px) clamp(20px, 4vw, 32px) clamp(56px, 8vw, 96px); font-size: 1.0625rem; line-height: 1.6; }
  .doc :global(h2) { margin: 40px 0 8px; font-size: 1.375rem; font-weight: 700; letter-spacing: -.03em; }
  .doc :global(p), .doc :global(ul) { margin: 0 0 12px; color: rgba(10,10,11,.8); }
  .doc :global(a) { text-decoration-color: rgba(10,10,11,.28); }
  .doc :global(h3) { margin: 28px 0 6px; font-size: 1.125rem; font-weight: 700; letter-spacing: -.01em; }
  /* Wide tables scroll inside their own box, never the page. */
  .doc :global(table) { display: block; overflow-x: auto; margin: 0 0 16px; border-collapse: collapse; font-size: .875rem; line-height: 1.45; }
  .doc :global(th), .doc :global(td) { padding: 8px 16px 8px 0; border-bottom: 1px solid rgba(10,10,11,.1); text-align: left; vertical-align: top; }
  /* A point the draft leaves open: highlighted wherever it sits, wrapped lines included. */
  .doc :global(mark.open) { padding: 1px 4px; border-radius: 4px; background: #fff1bf; color: #0a0a0a; -webkit-box-decoration-break: clone; box-decoration-break: clone; }
  .doc :global(.draft) { padding: 12px 16px; border-radius: 12px; background: #fff1bf; color: #0a0a0a; }
</style>
