---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import How from '../components/How.astro';
import More from '../components/More.astro';
import Stylist from '../components/Stylist.astro';
import Finale from '../components/Finale.astro';
import GetDialog from '../components/GetDialog.astro';
---
<Base path="/">
  <Header />
  <main>
    <Hero />
    <How />
    <More />
    <Stylist />
  </main>
  <Finale />
  <GetDialog />
</Base>

<script>
  import { landOnHash, startChrome } from '../scripts/chrome';
  import { startMotion } from '../motion/index';
  import { fitPhone } from '../motion/how';
  startChrome();
  fitPhone();
  startMotion();
  landOnHash();
</script>
