---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Finale from '../components/Finale.astro';
import GetDialog from '../components/GetDialog.astro';
---
<Base path="/">
  <Header />
  <main>
    <Hero />
  </main>
  <Finale />
  <GetDialog />
</Base>

<script>
  import { startChrome } from '../scripts/chrome';
  import { startMotion } from '../motion/index';
  startChrome();
  startMotion();
</script>
