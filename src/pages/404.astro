---
import Doc from '../layouts/Doc.astro';
import { COPY } from '../i18n/copy';

// One page for every unknown path: the path gives no language, so French first and English below.
const fr = COPY.fr.notFound, en = COPY.en.notFound;
---
<!-- Its language switch goes to the English home, so it takes the home page's path. -->
<Doc lang="fr" title={fr.title} path="/" noindex>
  <p>{fr.text}</p>
  <p><a href="/">{fr.home}</a></p>
  <h2 lang="en">{en.title}</h2>
  <p lang="en">{en.text} <a href="/en">{en.home}</a></p>
</Doc>
