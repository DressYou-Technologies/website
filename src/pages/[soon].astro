---
import Doc from '../layouts/Doc.astro';
import Soon from '../components/Soon.astro';
import { COPY } from '../i18n/copy';

// The company pages the menu and footer link, in the works and out of search until they have content.
export const getStaticPaths = () => COPY.fr.menu.links.map(([title, path]) => ({ params: { soon: path.slice(1) }, props: { title, path } }));
interface Props { title: string; path: string }
const { title, path } = Astro.props;
---
<Doc lang="fr" title={title} path={path} noindex><Soon lang="fr" /></Doc>
