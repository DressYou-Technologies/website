---
import { Image, Picture } from 'astro:assets';
import appIcon from '../assets/brand/app-icon.png';
import dewai from '../assets/brand/dewai-face.png';
import frame from '../assets/device/iphone-18-pro-black.png';
import { HOW } from '../data/site';
import { image } from '../lib/image';
import { COPY } from '../i18n/copy';
import type { Lang } from '../i18n/lang';

interface Props { lang: Lang }
const t = COPY[Astro.props.lang].how;
const renders = [HOW.shop.render, HOW.wardrobe.render, HOW.feed.render];
const post = HOW.feed.post;
// Each shop page's name and price come from the copy, in page order; the last page is the one shared.
const pages = HOW.shop.pages.map((page, k) => ({ ...page, name: t.shopPages[k][0], price: t.shopPages[k][1] }));
const shared = pages[pages.length - 1];
// Lucide icon paths (ISC). Safari's and the share sheet's follow iOS 27's glyphs; the app's follow the app kit.
const ICON = {
  back: ['m15 18-6-6 6-6'], page: ['M21 5H3', 'M15 12H3', 'M17 19H3'], reload: ['M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8', 'M21 3v5h-5'],
  tabs: ['M8 8h12a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H10a2 2 0 0 1-2-2Z', 'M4 16a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2'],
  translate: ['m5 8 6 6', 'm4 14 6-6 2-3', 'M2 5h12', 'M7 2h1', 'm22 22-5-10-5 10', 'M14 18h6'],
  share: ['M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8', 'm16 6-4-4-4 4', 'M12 2v13'],
  bookmark: ['m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z'],
  bookmarkTo: ['m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z', 'M12 7v6', 'M15 10H9'],
  find: ['M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z', 'M14 2v6h6', 'm16 18-1.6-1.6'],
  zoom: ['m21 21-4.3-4.3', 'M11 8v6', 'M8 11h6'],
  copy: ['M8 8h12a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H10a2 2 0 0 1-2-2Z', 'M4 16a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2'],
  glasses: ['M14 15a2 2 0 0 0-2-1 2 2 0 0 0-2 1', 'M2.5 13 5 7c.7-1.3 1.4-2 3-2', 'M21.5 13 19 7c-.7-1.3-1.5-2-3-2'],
  down: ['m6 9 6 6 6-6'], right: ['m9 18 6-6-6-6'],
  plus: ['M5 12h14', 'M12 5v14'], search: ['m21 21-4.3-4.3'], sliders: ['M10 5H3', 'M12 19H3', 'M14 3v4', 'M16 17v4', 'M21 12h-9', 'M21 19h-5', 'M21 5h-7', 'M8 10v4', 'M8 12H3'],
  shirt: ['M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z'],
  layers: ['M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z', 'M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12', 'M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17'],
  history: ['M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8', 'M3 3v5h5', 'M12 7v5l4 2'],
  chat: ['M7.9 20A9 9 0 1 0 4 16.1L2 22Z'], menu: ['M4 12h16', 'M4 6h16', 'M4 18h16'],
  home: ['M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8', 'M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z'],
  scan: ['M3 7V5a2 2 0 0 1 2-2h2', 'M17 3h2a2 2 0 0 1 2 2v2', 'M21 17v2a2 2 0 0 1-2 2h-2', 'M7 21H5a2 2 0 0 1-2-2v-2', 'M18.944 12.33a1 1 0 0 0 0-.66 7.5 7.5 0 0 0-13.888 0 1 1 0 0 0 0 .66 7.5 7.5 0 0 0 13.888 0'],
  change: ['M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8', 'M21 3v5h-5', 'M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16', 'M8 16H3v5'],
  friends: ['M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2', 'M22 21v-2a4 4 0 0 0-3-3.87', 'M16 3.13a4 4 0 0 1 0 7.75'],
  up: ['m5 12 7-7 7 7', 'M12 19V5'], check: ['M20 6 9 17l-5-5'],
};
type Icon = keyof typeof ICON;
// Circles the paths above leave out, per icon.
const CIRCLES: Partial<Record<Icon, [number, number, number][]>> = { search: [[11, 11, 8]], zoom: [[11, 11, 8]], glasses: [[6, 15, 4], [18, 15, 4]], friends: [[9, 7, 4]], scan: [[12, 12, 1]], find: [[13, 15, 3]] };
const MENU_ICONS: Icon[] = ['translate', 'share', 'bookmark', 'bookmarkTo', 'find', 'zoom'];
const ACTION_ICONS: Icon[] = ['copy', 'bookmark', 'glasses', 'down'];
const TAB_ICONS: Icon[] = ['shirt', 'layers', 'history'];
const SHARE_ROW = MENU_ICONS.indexOf('share');
---
<section class="how" id="how">
  <div class="hwrap">
    <div class="copy">
      <h2><span class="nowrap">{t.lead} <span class="soft">{t.from}</span></span><span class="nowrap"><span class="hroll" data-next={t.next}>{t.words.map((w) => <span class="hw">{w}</span>)}<span class="track" aria-hidden="true"><i class="hbar"></i></span></span></span></h2>
      <ol aria-label={t.stepsLabel}>{t.steps.map((s, i) => <li class="hstep"><span class="num">{String(i + 1).padStart(2, '0')}</span>{s}</li>)}</ol>
    </div>
    <div class="visual">
      <div class="hstage" aria-hidden="true">
        <div class="hfit">
          <!-- Apple's iPhone 18 Pro frame in Black, used as Apple's marketing guidelines ask: nothing overlaps it, no added shadow, and only the screen moves. -->
          <div class="hphone">
            <div class="screen">
              <!-- The screen is laid out in iOS points, 402 × 874, then scaled into the frame's opening. -->
              <div class="ui">
                <div class="hsrc shop">
                  <div class="spages">{pages.map((page) => (
                    <div class:list={['spage', page.theme]}>
                      <b class="sbrand">{page.brand}</b>
                      <div class="shot"><Picture class="cutout" src={image(page.image)} formats={['avif', 'webp']} widths={[300, 600]} sizes="260px" alt="" loading="lazy" /></div>
                      <b class="sname">{page.name}</b>
                      <span class="sprice">{page.price}</span>
                      <div class="sizes">{['XS', 'S', 'M', 'L'].map((size) => <span>{size}</span>)}</div>
                    </div>
                  ))}</div>
                  <div class="toolbar">
                    <span class="glass round"><svg viewBox="0 0 24 24">{ICON.back.map((d) => <path d={d} />)}</svg></span>
                    <span class="glass address">
                      <span class="pagebtn"><svg viewBox="0 0 24 24">{ICON.page.map((d) => <path d={d} />)}</svg><span class="hring dark"></span></span>
                      <span class="domains">{pages.map((page) => <span>{page.domain}</span>)}</span>
                      <svg viewBox="0 0 24 24">{ICON.reload.map((d) => <path d={d} />)}</svg>
                    </span>
                    <span class="glass round"><svg viewBox="0 0 24 24">{ICON.tabs.map((d) => <path d={d} />)}</svg></span>
                  </div>
                  <div class="pmenu glass">{t.safari.menu.map((label, k) => (
                    <span class:list={['prow', { rule: k === 1 || k === 4, pshare: k === SHARE_ROW }]}><svg viewBox="0 0 24 24">{ICON[MENU_ICONS[k]].map((d) => <path d={d} />)}{(CIRCLES[MENU_ICONS[k]] ?? []).map(([cx, cy, r]) => <circle cx={cx} cy={cy} r={r} />)}</svg>{label}</span>
                  ))}</div>
                  <div class="sheet glass">
                    <div class="sh-head">
                      <span class="sh-thumb"><Picture class="cutout" src={image(shared.image)} formats={['avif', 'webp']} widths={[80, 160]} sizes="42px" alt="" loading="lazy" /></span>
                      <span class="sh-what"><b>{shared.name}</b><span>{shared.domain}</span><span class="sh-options">{t.safari.options}<svg viewBox="0 0 24 24">{ICON.right.map((d) => <path d={d} />)}</svg></span></span>
                    </div>
                    <div class="sh-apps">
                      <span class="app" data-tap><Image src={appIcon} width={64} height={64} densities={[1, 2]} alt="" /><span>DressYou</span><span class="hring dark"></span></span>
                      <span class="app"><span class="ico"><i></i><i></i><i></i></span><span>{t.safari.more}</span></span>
                    </div>
                    <div class="sh-acts">{t.safari.actions.map((label, k) => (
                      <span class="act"><span class="ico"><svg viewBox="0 0 24 24">{ICON[ACTION_ICONS[k]].map((d) => <path d={d} />)}{(CIRCLES[ACTION_ICONS[k]] ?? []).map(([cx, cy, r]) => <circle cx={cx} cy={cy} r={r} />)}</svg></span><span>{label}</span></span>
                    ))}</div>
                  </div>
                </div>
                <div class="hsrc wardrobe app-screen">
                  <div class="abar"><svg viewBox="0 0 24 24">{ICON.plus.map((d) => <path d={d} />)}</svg><b>{t.wardrobe.title}</b><i></i></div>
                  <div class="asearch"><span class="pill"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8" />{ICON.search.map((d) => <path d={d} />)}</svg><span>{t.wardrobe.search}</span><svg viewBox="0 0 24 24">{ICON.sliders.map((d) => <path d={d} />)}</svg></span><span class="pill sel">{t.wardrobe.select}</span></div>
                  <div class="segs">{t.wardrobe.tabs.map((tab, k) => <span class={k === 0 ? 'on' : undefined}><svg viewBox="0 0 24 24">{ICON[TAB_ICONS[k]].map((d) => <path d={d} />)}</svg>{tab}</span>)}</div>
                  <div class="grid">{HOW.wardrobe.grid.map((id) => (
                    <span class:list={['tile', { hpk: HOW.wardrobe.picks.includes(id) }]}><Picture class="cutout" src={image(id)} formats={['avif', 'webp']} widths={[160, 260]} sizes="80px" alt="" loading="lazy" /><span class="tick"><svg viewBox="0 0 24 24">{ICON.check.map((d) => <path d={d} />)}</svg></span></span>
                  ))}</div>
                  <div class="tabbar">
                    <span class="glass tabs"><span><svg viewBox="0 0 24 24">{ICON.home.map((d) => <path d={d} />)}</svg></span><span class="on"><svg viewBox="0 0 24 24">{ICON.shirt.map((d) => <path d={d} />)}</svg></span><span><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8" />{ICON.search.map((d) => <path d={d} />)}</svg></span><span class="me"></span></span>
                    <span class="glass orb"><Image src={dewai} width={44} height={44} densities={[1, 2]} alt="" /></span>
                  </div>
                  <span class="htry" data-tap>{t.wardrobe.tryOn}<span class="hring"></span></span>
                </div>
                <div class="hsrc feed app-screen">
                  <div class="abar"><svg viewBox="0 0 24 24">{ICON.plus.map((d) => <path d={d} />)}</svg><b>{t.feed.title}</b><svg viewBox="0 0 24 24">{ICON.chat.map((d) => <path d={d} />)}</svg></div>
                  <div class="asearch"><span class="pill wide"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8" />{ICON.search.map((d) => <path d={d} />)}</svg><span>{t.feed.search}</span></span></div>
                  <div class="ftabs">{t.feed.tabs.map((tab, k) => <span class={k === 0 ? 'on' : undefined}>{tab}</span>)}</div>
                  <div class="who"><span class="avatar">{post.handle[0].toUpperCase()}</span><b>{post.handle}</b><span class="age">{post.age}</span><svg viewBox="0 0 24 24">{ICON.menu.map((d) => <path d={d} />)}</svg></div>
                  <div class="post"><Picture src={image(post.image)} formats={['avif', 'webp']} widths={[400, 800]} sizes="262px" alt="" loading="lazy" /><span class="glass scan" data-tap><svg viewBox="0 0 24 24">{ICON.scan.map((d) => <path d={d} />)}<circle cx="12" cy="12" r="1" /></svg><span class="hring dark"></span></span></div>
                  <div class="tabbar">
                    <span class="glass tabs"><span><svg viewBox="0 0 24 24">{ICON.home.map((d) => <path d={d} />)}</svg></span><span><svg viewBox="0 0 24 24">{ICON.shirt.map((d) => <path d={d} />)}</svg></span><span class="on"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8" />{ICON.search.map((d) => <path d={d} />)}</svg></span><span class="me"></span></span>
                    <span class="glass orb"><Image src={dewai} width={44} height={44} densities={[1, 2]} alt="" /></span>
                  </div>
                </div>
                {renders.map((id, i) => (
                  <div class:list={['hren', 'app-screen', { first: i === 0 }]}>
                    <div class="abar"><svg viewBox="0 0 24 24">{ICON.down.map((d) => <path d={d} />)}</svg><b>{t.tryOn.title}</b><i></i></div>
                    <div class="rcard"><Picture class="hrimg" src={image(id)} formats={['avif', 'webp']} widths={[400, 800]} sizes="262px" alt="" loading="lazy" /><span class="badge">{t.tryOn.badge}</span><span class="hsweep"></span></div>
                    <div class="racts"><span class="pill out"><svg viewBox="0 0 24 24">{ICON.change.map((d) => <path d={d} />)}</svg>{t.tryOn.change}</span><span class="pill out round"><svg viewBox="0 0 24 24">{ICON.bookmark.map((d) => <path d={d} />)}</svg></span><span class="pill out round"><svg viewBox="0 0 24 24"><circle cx="9" cy="7" r="4" />{ICON.friends.map((d) => <path d={d} />)}</svg></span></div>
                    <span class="hin"><span class="field"><span class="hph">{t.tryOn.ask}</span><span class="htype"></span></span><span class="hsend"><svg viewBox="0 0 24 24">{ICON.up.map((d) => <path d={d} />)}</svg></span></span>
                  </div>
                ))}
                <div class="status"><span>9:41</span><span class="sicons"><svg class="cell" viewBox="0 0 18 12"><rect x="0" y="8" width="3" height="4" rx="1" /><rect x="5" y="5.5" width="3" height="6.5" rx="1" /><rect x="10" y="3" width="3" height="9" rx="1" /><rect x="15" y="0" width="3" height="12" rx="1" /></svg><svg class="wifi" viewBox="0 0 24 24"><path d="M2 8.82a15 15 0 0 1 20 0" /><path d="M5 12.86a10 10 0 0 1 14 0" /><path d="M8.5 16.43a5 5 0 0 1 7 0" /><path d="M12 20h.01" /></svg><span class="battery"><span></span></span></span></div>
                <span class="home-bar"></span>
              </div>
            </div>
            <Picture class="frame" src={frame} formats={['avif', 'webp']} widths={[330, 660, 990]} sizes="330px" alt="" loading="lazy" />
          </div>
          {t.scenes.map(({ sizes, q, a }, i) => (
            <div class:list={['hpop', { first: i === 0 }]}>
              <div class="hsz"><span class="label">{t.sizeLabel}</span>{sizes.map(([letter, fit, why], k) => (
                <span class:list={['hszr', { chosen: k === 0 }]}><span class="letter">{letter}</span><span class="why"><b>{fit}</b><span>{why}</span></span></span>
              ))}</div>
              <div class="hq">{q}</div>
              <div class="hdots"><i></i><i></i><i></i></div>
              <div class="ha"><span>{a}</span></div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .how { padding: var(--section-pad) clamp(16px, 3vw, 48px); }
  .hwrap { position: relative; max-width: 1200px; margin: 0 auto; display: flex; flex-wrap: wrap; align-items: center; gap: clamp(24px, 5vw, 80px); }
  .copy { flex: 1 1 340px; min-width: 0; display: grid; gap: clamp(24px, 4svh, 52px); }
  h2 { margin: 0; text-align: left; font-size: clamp(2rem, 3.8vw, 3.75rem); font-weight: 700; letter-spacing: -.05em; line-height: 1.04; }
  .nowrap { display: block; white-space: nowrap; }
  .soft { color: #a1a1a1; }
  .hroll { position: relative; display: inline-grid; padding-bottom: .12em; cursor: pointer; }
  .hw { grid-area: 1 / 1; justify-self: start; white-space: nowrap; }
  .hw + .hw { opacity: 0; visibility: hidden; }
  .track { position: absolute; left: 0; right: 0; bottom: 0; height: 3px; border-radius: 2px; background: rgba(10,10,10,.08); overflow: hidden; }
  .hbar { display: block; height: 100%; background: #0a0a0a; transform-origin: left; transform: scaleX(0); }
  ol { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(10px, 1.6vw, 16px); }
  .hstep { display: flex; align-items: baseline; gap: 14px; color: #bdbdbd; font-size: clamp(1.25rem, 2vw, 1.625rem); font-weight: 600; letter-spacing: -.03em; line-height: 1.15; }
  .hstep:first-child { color: #0a0a0a; }
  .num { font-family: var(--font-mono); font-size: 11px; font-weight: 500; letter-spacing: .1em; min-width: 2.4ch; }

  .visual { flex: 1.5 1 440px; min-width: 0; container-type: inline-size; }
  /* The scene is laid out at its own size, then scaled as one piece to its stage (fitPhone), which the screen's height bounds
     so the section reads in one screen. Wide: the bubbles stand beside the phone. */
  .hstage { --scene-w: 600px; --scene-h: 660px; position: relative; width: 100%; height: clamp(440px, calc(100svh - 2 * var(--section-pad)), 800px); overflow: visible; }
  /* Centred by half its size, which still holds when the unscaled scene is wider than the stage. */
  .hfit { --phone-h: 600; position: absolute; left: 50%; top: 50%; width: var(--scene-w); height: var(--scene-h); margin: calc(var(--scene-h) / -2) 0 0 calc(var(--scene-w) / -2); }
  .hphone { position: absolute; left: 0; top: 30px; height: calc(var(--phone-h) * 1px); aspect-ratio: 1350 / 2760; }
  .hphone :global(.frame) { position: absolute; inset: 0; z-index: 6; width: 100%; height: 100%; pointer-events: none; }
  /* The frame's screen opening, measured on Apple's 1350 × 2760 PNG: 72 px in from the sides, 69 px from the top and bottom,
     corners of 207 px; the screen tucks 1 px under the frame so no edge shows through. */
  .screen { position: absolute; inset: calc(69 / 2760 * 100% - 1px) calc(72 / 1350 * 100% - 1px); border-radius: calc(var(--phone-h) * 207 / 2760 * 1px); overflow: hidden; background: #f4f4f2; }
  /* Apple's PNG is drawn at 3×: its 1206 × 2622 px opening is the iPhone 18 Pro's 402 × 874 pt screen, 920 pt tall overall. */
  .ui { position: absolute; left: 1px; top: 1px; width: 402px; height: 874px; transform: scale(calc(var(--phone-h) / 920)); transform-origin: 0 0; color: #0a0a0b; font-size: 17px; }
  :global(picture), .ui :global(img) { display: block; }
  .ui svg { flex: none; width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .hsrc, .hren { position: absolute; inset: 0; }
  /* Without motion the phone shows the first try-on; the sources only appear while it plays. */
  .hsrc { opacity: 0; visibility: hidden; }
  .hring { position: absolute; left: 50%; top: 50%; width: 64px; height: 64px; margin: -32px 0 0 -32px; border-radius: 50%; box-shadow: 0 0 0 3px #ffffff; opacity: 0; pointer-events: none; }
  .hring.dark { box-shadow: 0 0 0 3px #0a0a0a; }

  /* The system's chrome: status bar and home indicator, as iOS 27 draws them on the iPhone 18 Pro. */
  .status { position: absolute; left: 0; right: 0; top: 18px; z-index: 5; display: flex; align-items: center; justify-content: space-between; height: 28px; padding: 0 34px 0 44px; font-family: -apple-system, BlinkMacSystemFont, var(--font-sans); font-size: 17px; font-weight: 600; pointer-events: none; }
  .sicons { display: flex; align-items: center; gap: 7px; }
  .sicons .cell { width: 18px; height: 12px; fill: currentColor; stroke: none; }
  .sicons .wifi { width: 18px; height: 18px; stroke-width: 2.6; }
  .battery { width: 27px; height: 13px; padding: 2px; border-radius: 4px; box-shadow: inset 0 0 0 1px rgba(10,10,11,.4); }
  .battery span { display: block; width: 80%; height: 100%; border-radius: 2px; background: currentColor; }
  .home-bar { position: absolute; left: 50%; bottom: 8px; z-index: 5; width: 139px; height: 5px; margin-left: -69.5px; border-radius: 3px; background: #0a0a0b; pointer-events: none; }
  /* Liquid Glass: frosted white, a hairline edge and a soft lift (iOS 27 captures). */
  .glass { background: rgba(255,255,255,.82); box-shadow: inset 0 0 0 1px rgba(10,10,11,.08), inset 0 1px 0 rgba(255,255,255,.9), 0 6px 20px rgba(10,10,11,.1); backdrop-filter: blur(16px) saturate(1.6); }

  /* Safari: a shop's product page, the bottom toolbar, its page menu and the share sheet. */
  .shop { background: #fff; font-family: -apple-system, BlinkMacSystemFont, var(--font-sans); }
  .spages { position: absolute; inset: 0; overflow: hidden; }
  .spage { position: absolute; inset: 0; padding: 84px 16px 0; background: #fff; }
  .spage.sand { background: #f3eee6; }
  .sbrand { display: block; margin-bottom: 18px; text-align: center; font-size: 16px; font-weight: 700; letter-spacing: .32em; text-transform: uppercase; }
  .shot { position: relative; height: 470px; background: #f2f1ee; }
  .sand .shot { background: #ebe4d9; }
  .shot :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .sname { display: block; margin-top: 18px; font-size: 21px; letter-spacing: -.01em; }
  .sprice { display: block; margin-top: 2px; color: #6b6b6b; font-size: 17px; }
  .sizes { display: flex; gap: 10px; margin-top: 14px; }
  .sizes span { display: grid; place-items: center; width: 52px; height: 46px; box-shadow: inset 0 0 0 1px rgba(10,10,11,.2); font-size: 16px; }
  .toolbar { position: absolute; left: 33px; right: 34px; bottom: 34px; z-index: 2; display: flex; align-items: center; gap: 8px; height: 48px; }
  .toolbar .round { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; }
  .toolbar .round:first-child svg { color: rgba(10,10,11,.3); }
  .address { flex: 1; display: flex; align-items: center; justify-content: space-between; height: 48px; padding: 0 14px; border-radius: 24px; }
