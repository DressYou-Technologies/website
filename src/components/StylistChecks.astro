---
import type { CheckKind } from '../i18n/copy';

// What the stylist checked before it answers: one icon and one short line a row, each row lighting up in turn
// (motion/stylist.ts), all lit without motion.
interface Props { title: string; checks: [kind: CheckKind, line: string][] }
const { title, checks } = Astro.props;
// Lucide icon paths (ISC), one per kind of check; circles and rects the paths leave out are listed beside them.
const ICON: Record<CheckKind, { paths: string[]; circles?: [number, number, number][]; rect?: true }> = {
  weather: { paths: ['M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242', 'M16 14v6', 'M8 14v6', 'M12 16v6'] },
  calendar: { paths: ['M16 2v4', 'M8 2v4', 'M3 10h18'], rect: true },
  wardrobe: { paths: ['M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z'] },
  style: { paths: ['M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z'] },
  budget: { paths: ['M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1', 'M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4'] },
  size: { paths: ['M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z'], circles: [[7.5, 7.5, 1]] },
  delivery: { paths: ['M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2', 'M15 18H9', 'M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14'], circles: [[17, 18, 2], [7, 18, 2]] },
  outfits: { paths: ['M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z', 'M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12', 'M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17'] },
};
---
<div class="sck">
  <span class="ck-title">{title}</span>
  {checks.map(([kind, line]) => (
    <span class="ck">
      <span class="ck-ico"><svg viewBox="0 0 24 24" aria-hidden="true">{ICON[kind].rect && <rect width="18" height="18" x="3" y="4" rx="2" />}{ICON[kind].paths.map((d) => <path d={d} />)}{(ICON[kind].circles ?? []).map(([cx, cy, r]) => <circle cx={cx} cy={cy} r={r} />)}</svg></span>
      <span class="ck-text">{line}</span>
    </span>
  ))}
</div>

<style>
  /* Small and quiet: each row is its icon and one line, so the two read as a pair (founder, 2026-11-02). */
  .sck { display: grid; gap: 7px; justify-self: start; width: fit-content; max-width: 100%; padding: 12px 16px 13px 12px; border-radius: 16px; background: #fff; box-shadow: 0 0 0 1px rgba(10,10,10,.06), 0 8px 20px rgba(0,0,0,.04); }
  .ck-title { margin: 0 0 1px 2px; font-size: .75rem; font-weight: 500; color: #8a8a8a; }
  /* The icon sits on the line's first row, so a line that wraps stays beside its own icon. */
  .ck { display: flex; align-items: flex-start; gap: 10px; }
  /* White icons on black, as the stylist's chosen tab (founder, 2026-10-31). */
  .ck-ico { flex: none; display: grid; place-items: center; width: 22px; height: 22px; border-radius: 7px; background: #0a0a0a; color: #fff; }
  svg { width: 13px; height: 13px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .ck-text { min-width: 0; padding-top: 2px; font-size: .875rem; line-height: 18px; color: #0a0a0a; }
</style>
