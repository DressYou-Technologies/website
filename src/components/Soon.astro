---
import { LINKS } from '../data/site';
import { COPY } from '../i18n/copy';
import { localize, type Lang } from '../i18n/lang';

// A page in the works: the same message on every one, until its content arrives (founder, 2026-11-01).
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = COPY[lang];
---
<p class="tag">{t.soon.tag}</p>
<p>{t.soon.text} <a href={`mailto:${LINKS.email}`}>{LINKS.email}</a>.</p>
<p><a href={localize(lang, '/')}>{t.doc.home}</a></p>

<style>
  .tag { display: inline-block; padding: 4px 10px; border-radius: 999px; background: #f1f1ef; color: #0a0a0a; font-family: var(--font-mono); font-size: 11px; letter-spacing: .16em; text-transform: uppercase; }
</style>
