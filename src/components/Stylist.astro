---
import { Picture } from 'astro:assets';
import StylistChecks from './StylistChecks.astro';
import { HOW, STYLIST } from '../data/site';
import { image } from '../lib/image';
import { COPY } from '../i18n/copy';
import type { Lang } from '../i18n/lang';

interface Props { lang: Lang }
const t = COPY[Astro.props.lang].stylist;

// Icon paths (Lucide, ISC): opinion, day, trip, find, shop, then send.
const ICONS = {
  opinion: ['M7.9 20A9 9 0 1 0 4 16.1L2 22Z'],
  day: ['M12 2v2', 'm4.93 4.93 1.41 1.41', 'M20 12h2', 'm19.07 4.93-1.41 1.41', 'M15.947 12.65a4 4 0 0 0-5.925-4.128', 'M13 22H7a5 5 0 1 1 4.9-6H13a3 3 0 0 1 0 6Z'],
  trip: ['M6 20a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2', 'M8 18V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v14', 'M10 20h4'],
  find: ['M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z'],
  shop: ['M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z', 'M3 6h18', 'M16 10a4 4 0 0 1-8 0'],
  send: ['m5 12 7-7 7 7', 'M12 19V5'],
};
// Icons per tab and per context chip; their words come from the copy, in the same order.
const TABS = (['opinion', 'day', 'trip', 'find', 'shop'] as const).map((icon, k) => [icon, t.tabs[k]] as const);
---
<section class="stylist" id="stylist">
  <div class="sstage">
    <div class="shead">
      <h2>{t.title}</h2>
      <ol class="stabs" aria-label={t.tabsLabel}>
        {TABS.map(([icon, label], i) => (
          <li class:list={['stab', { on: i === 0 }]}>
            <span class="sico"><svg viewBox="0 0 24 24" aria-hidden="true">{ICONS[icon].map((d) => <path d={d} />)}{icon === 'trip' && <><circle cx="16" cy="20" r="2" /><circle cx="8" cy="20" r="2" /></>}</svg></span>
            <span class="slabel">{label}</span>
          </li>
        ))}
      </ol>
    </div>
    <div class="schat" aria-hidden="true">
      <div class="sview">
        <div class="strack">
          <div class="sg" data-q={t.opinion.q}>
            <div class="sq"><span class="sq-item"><span class="piece mini"><Picture class="cutout" src={image(STYLIST.opinion)} formats={['avif', 'webp']} widths={[80, 160]} sizes="44px" alt="" loading="lazy" /></span><span class="sq-meta"><b>{t.opinion.item}</b><span>{HOW.shop.pages[HOW.shop.pages.length - 1].domain}</span></span></span>{t.opinion.q}</div>
            <div class="sa">
              <StylistChecks title={t.checked} checks={t.opinion.checks} />
              <p class="sin sbub">{t.opinion.a}</p>
            </div>
          </div>
          <div class="sg" data-q={t.day.q}>
            <p class="sq">{t.day.q}</p>
            <div class="sa">
              <StylistChecks title={t.checked} checks={t.day.checks} />
              <p class="sin sbub">{t.day.a}</p>
              <div class="sin pieces">{STYLIST.dinner.map((id) => <span class="piece"><Picture class="cutout" src={image(id)} formats={['avif', 'webp']} widths={[100, 200]} sizes="96px" alt="" loading="lazy" /></span>)}</div>
              <span class="sin cta">{t.day.cta}</span>
            </div>
          </div>
          <div class="sg" data-q={t.trip.q}>
            <p class="sq">{t.trip.q}</p>
            <div class="sa">
              <StylistChecks title={t.checked} checks={t.trip.checks} />
              <div class="sin panel"><div class="trip-head"><span class="mono">{t.trip.head}</span><span class="muted">{t.trip.count}</span></div><div class="trip">{STYLIST.trip.map((id) => <span class="piece small"><Picture class="cutout" src={image(id)} formats={['avif', 'webp']} widths={[80, 160]} sizes="78px" alt="" loading="lazy" /></span>)}</div></div>
              <p class="sin sbub">{t.trip.a}</p>
            </div>
          </div>
          <div class="sg" data-q={t.find.q}>
            <p class="sq">{t.find.q}</p>
            <div class="sa">
              <StylistChecks title={t.checked} checks={t.find.checks} />
              <div class="sin result"><span class="piece large"><Picture class="cutout" src={image(STYLIST.find)} formats={['avif', 'webp']} widths={[120, 220]} sizes="110px" alt="" loading="lazy" /></span><span class="result-copy"><b>{t.find.name}</b><span>{t.find.price}</span><span class="muted">{t.find.fit}</span></span></div>
              <span class="sin cta">{t.find.cta}</span>
            </div>
          </div>
          <div class="sg" data-q={t.buy.q}>
            <p class="sq">{t.buy.q}</p>
            <div class="sa">
              <StylistChecks title={t.checked} checks={t.buy.checks} />
              <p class="sin sbub">{t.buy.a}</p>
              <div class="sin result"><span class="piece large"><Picture class="cutout" src={image(STYLIST.buy)} formats={['avif', 'webp']} widths={[120, 220]} sizes="110px" alt="" loading="lazy" /></span><span class="result-copy"><b>{t.buy.name}</b><span>{t.buy.price}</span></span></div>
              <span class="sin cta outline">{t.buy.cta}</span>
            </div>
          </div>
        </div>
      </div>
      <div class="input">
        <span class="field"><span class="sph">{t.ask}</span><span class="stype"></span></span>
        <span class="ssend"><svg viewBox="0 0 24 24" aria-hidden="true">{ICONS.send.map((d) => <path d={d} />)}</svg></span>
      </div>
    </div>
  </div>
</section>

<style>
  .stylist { position: relative; }
  .sstage { max-width: 1400px; margin: 0 auto; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: clamp(24px, 4.5vw, 64px); padding: var(--section-pad) clamp(16px, 3vw, 48px); }
  .shead { flex: 0 1 380px; min-width: 0; display: grid; gap: clamp(18px, 4svh, 36px); align-content: center; }
  h2 { margin: 0; font-size: clamp(1.875rem, min(4vw, 7.5svh), 3.375rem); font-weight: 700; letter-spacing: -.05em; line-height: 1; }
  .stabs { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(10px, 2.2svh, 18px); }
  .stab { display: flex; align-items: center; gap: 14px; }
  .sico { width: clamp(38px, 5.5svh, 48px); height: clamp(38px, 5.5svh, 48px); flex: none; border-radius: 32%; display: grid; place-items: center; background: #f4f4f2; color: #0a0a0a; }
  .stab.on .sico { background: #0a0a0a; color: #fff; }
  svg { width: 20px; height: 20px; flex: none; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .slabel { display: flex; align-items: center; gap: 10px; font-size: clamp(1.0625rem, min(1.85vw, 3.4svh), 1.5rem); font-weight: 700; letter-spacing: -.035em; line-height: 1.1; }
  .schat { position: relative; flex: 1 1 440px; min-width: 0; max-width: 820px; display: flex; flex-direction: column; }
  .sview { position: relative; flex: 1; min-height: 0; overflow: hidden; -webkit-mask-image: linear-gradient(180deg, rgba(0,0,0,0), #000 64px); mask-image: linear-gradient(180deg, rgba(0,0,0,0), #000 64px); }
  .strack { display: flex; flex-direction: column; padding: 40px clamp(18px, 4vw, 36px) 0; }
  .sg { display: flex; flex-direction: column; gap: 16px; padding-bottom: 28px; }
  .sq { align-self: flex-end; display: grid; justify-items: start; gap: 10px; max-width: 70%; margin: 0; padding: 14px 20px; border-radius: 24px 24px 8px 24px; background: #efefed; font-size: 1.0625rem; line-height: 1.45; }
  /* A question about a piece carries the piece, as a link shared from the shop. */
  .sq-item { display: flex; align-items: center; gap: 10px; margin: -4px -10px 0 -8px; padding: 6px 14px 6px 6px; border-radius: 16px; background: #fff; }
  .sq-meta { display: grid; gap: 1px; line-height: 1.25; }
  .sq-meta b { font-size: .875rem; }
  .sq-meta span { font-size: .75rem; color: #6b6b6b; }
  .piece.mini { width: 44px; border-radius: 10px; box-shadow: none; background: #f4f4f2; }
  .sa { position: relative; display: flex; flex-direction: column; gap: 14px; align-items: flex-start; }
  .sbub { max-width: min(56ch, 82%); margin: 0; padding: 14px 20px; border-radius: 24px 24px 24px 8px; background: #0a0a0a; color: #fff; font-size: 1.0625rem; line-height: 1.5; text-wrap: pretty; }
  .mono { font-family: var(--font-mono); font-size: 10px; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; color: #6b6b6b; }
  .pieces, .trip { display: flex; flex-wrap: wrap; gap: 10px; }
  .trip { gap: 8px; }
  .piece { position: relative; display: block; flex: none; width: clamp(64px, 9vw, 96px); aspect-ratio: 3 / 4; border-radius: 14px; overflow: hidden; background: #fff; box-shadow: 0 6px 16px rgba(0,0,0,.06); }
  .piece.small { width: clamp(38px, 7vw, 78px); }
  .piece.large { width: clamp(80px, 10vw, 110px); }
  .piece :global(picture) { display: block; }
  .piece :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .cta { display: inline-flex; align-items: center; justify-content: center; height: 44px; padding: 0 22px; border-radius: 22px; background: #0a0a0a; color: #fff; font-size: .9375rem; font-weight: 700; }
  .cta.outline { background: none; color: #0a0a0a; box-shadow: inset 0 0 0 1px rgba(10,10,10,.28); }
  .panel { padding: 16px; border-radius: 22px; background: #fff; box-shadow: 0 0 0 1px rgba(10,10,10,.06), 0 14px 30px rgba(0,0,0,.08); }
  .trip-head { display: flex; justify-content: space-between; gap: 16px; align-items: center; margin-bottom: 12px; }
  .trip-head .mono { letter-spacing: .16em; color: inherit; }
  .muted { font-size: .875rem; color: #6b6b6b; }
  /* A proposed piece: its image and its words side by side, the button on its own below. */
  .result { display: flex; gap: 16px; align-items: center; }
  .result-copy { display: grid; gap: 4px; }
  .result-copy b { font-size: 1.0625rem; letter-spacing: -.02em; }
  .result-copy span { font-size: .9375rem; }
  .result-copy .muted { font-size: .875rem; }
  .input { flex: none; display: flex; align-items: center; gap: 10px; height: 60px; margin: 10px 14px 14px; padding: 6px 6px 6px 22px; border-radius: 30px; background: #fff; box-shadow: 0 10px 30px rgba(0,0,0,.07), inset 0 0 0 1px rgba(10,10,10,.05); }
  .field { position: relative; flex: 1; min-width: 0; height: 24px; font-size: 1.0625rem; line-height: 24px; }
  .sph { position: absolute; inset: 0; color: #6b6b6b; }
  .stype { position: absolute; inset: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ssend { width: 48px; height: 48px; flex: none; border-radius: 50%; background: #0a0a0a; color: #fff; display: grid; place-items: center; }
</style>
