---
import { Image } from 'astro:assets';
import GetLink from './GetLink.astro';
import NotifyForm from './NotifyForm.astro';
import { LINKS } from '../data/site';
import logo from '../assets/brand/logo-white.png';
import { COPY } from '../i18n/copy';
import { LANGS, localize, type Lang } from '../i18n/lang';

interface Props { lang: Lang; path: string }
const { lang, path } = Astro.props;
const t = COPY[lang];
const other = LANGS.find((l) => l !== lang) ?? lang;
// Links are written for the root ("/#how", "/legal") and land on the same language's page.
const href = (link: string) => { const [page, hash] = link.split('#'); return localize(lang, page || '/') + (hash ? `#${hash}` : ''); };
const year = new Date().getFullYear();
---
<footer class="finale" id="get" data-tone="dark">
  <div class="row">
    <h2 class="mega">{t.finale.mega.map((w) => <span class="w">{w}</span>)}</h2>
    <div class="join">
      <p class="lede">{t.finale.notify}</p>
      <NotifyForm lang={lang} dark />
      <GetLink kind="extension" class="xchip"><svg viewBox="0 0 24 24" aria-hidden="true" width="16" height="16"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="4"></circle><path d="M21.17 8H12"></path><path d="M3.95 6.06 8.54 14"></path><path d="M10.88 21.94 15.46 14"></path></svg>{t.finale.extension}{!LINKS.extensionUrl && <span>{t.finale.soon}</span>}</GetLink>
    </div>
  </div>
  <nav class="cols" aria-label={t.finale.footer}>
    {t.finale.columns.map(({ label, links }) => (
      <div><p>{label}</p>{links.map(([text, link]) => <a href={href(link)}>{text}</a>)}</div>
    ))}
    <div><p>{t.lang.heading}</p><a href={localize(other, path)} hreflang={other} lang={other}>{t.lang.switchTo}</a></div>
  </nav>
  <div class="base">
    <Image src={logo} height={22} densities={[1, 2]} alt="DressYou" />
    <p class="facts"><span>© {year} DressYou Technologies</span><span>47 rue Vivienne, 75002 Paris</span><a href={`mailto:${LINKS.email}`}>{LINKS.email}</a></p>
  </div>
</footer>

<style>
  .finale { margin: 0 12px 12px; padding: clamp(40px, 6svh, 72px) clamp(20px, 3vw, 48px) clamp(24px, 3svh, 32px); border-radius: 28px; background: radial-gradient(110% 90% at 85% 0%, #2a2a2e 0%, #151517 45%, #0e0e10 100%); color: #fff; display: grid; gap: clamp(36px, 6svh, 72px); }
  .row { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 32px 48px; }
  .mega { margin: 0; font-size: clamp(2.875rem, 8vw, 7rem); font-weight: 700; letter-spacing: -.06em; line-height: .95; }
  .w { display: block; white-space: nowrap; }
  .join { flex: 0 1 420px; min-width: min(100%, 300px); display: grid; gap: 14px; }
  .lede { margin: 0; color: #cfcfcf; font-size: 1.0625rem; line-height: 1.4; text-wrap: balance; }
  .join :global(.xchip) { justify-self: start; display: inline-flex; align-items: center; gap: 8px; height: 36px; padding: 0 14px 0 12px; border: 0; border-radius: 999px; background: none; color: #cfcfcf; font: inherit; font-size: .875rem; font-weight: 600; text-decoration: none; box-shadow: inset 0 0 0 1px rgba(255,255,255,.16); cursor: pointer; transition: color .2s, box-shadow .2s; }
  .join :global(.xchip:hover) { color: #fff; box-shadow: inset 0 0 0 1px rgba(255,255,255,.4); }
  .join :global(.xchip svg) { fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .join :global(.xchip span) { font-family: var(--font-mono); font-size: 9px; font-weight: 500; letter-spacing: .16em; text-transform: uppercase; color: #8a8a8a; }
  .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 28px 32px; padding-top: 32px; border-top: 1px solid rgba(255,255,255,.1); }
  .cols div { display: grid; gap: 10px; align-content: start; }
  .cols p { margin: 0 0 4px; font-family: var(--font-mono); font-size: 10px; font-weight: 500; letter-spacing: .2em; text-transform: uppercase; color: #8a8a8a; }
  .cols a, .facts a { color: #cfcfcf; font-size: .9375rem; text-decoration: none; transition: color .2s; }
  .cols a:hover, .facts a:hover { color: #fff; }
  .base { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 28px; padding-top: 24px; border-top: 1px solid rgba(255,255,255,.1); }
  .base img { width: auto; height: 22px; }
  .facts { display: flex; flex-wrap: wrap; gap: 6px 20px; margin: 0; color: #8a8a8a; font-size: .8125rem; }
  .facts a { font-size: .8125rem; }
</style>
