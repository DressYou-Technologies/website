---
import { Image } from 'astro:assets';
import GetLink from './GetLink.astro';
import DownloadIcon from './DownloadIcon.astro';
import { LINKS } from '../data/site';
import logo from '../assets/brand/logo-white.png';
import { COPY } from '../i18n/copy';
import { LANGS, localize, type Lang } from '../i18n/lang';

interface Props { lang: Lang; path: string }
const { lang, path } = Astro.props;
const t = COPY[lang];
const other = LANGS.find((l) => l !== lang) ?? lang;
// Links are written for the root ("/#how", "/legal") and land on the same language's page.
const href = (link: string) => { const [page, hash] = link.split('#'); return localize(lang, page || '/') + (hash ? `#${hash}` : ''); };
---
<footer class="finale" id="get">
  <div class="row">
    <h2 class="mega">{t.finale.mega.map((w) => <span class="w">{w}</span>)}</h2>
    <div class="finale-cta">
      <GetLink kind="app" class="cta-app">{t.get.app}</GetLink>
      <GetLink kind="extension" class="cta-ext"><DownloadIcon size={18} />{t.get.extension}</GetLink>
    </div>
  </div>
  <div class="base">
    <div class="who">
      <Image src={logo} height={26} densities={[1, 2]} alt="DressYou" />
      <a href={`mailto:${LINKS.email}`}>{LINKS.email}</a>
    </div>
    <nav aria-label={t.finale.footer}>
      {t.finale.columns.map(({ label, links }) => (
        <div><p>{label}</p>{links.map(([text, link]) => <a href={href(link)}>{text}</a>)}</div>
      ))}
      <div><p>{t.lang.heading}</p><a href={localize(other, path)} hreflang={other} lang={other}>{t.lang.switchTo}</a></div>
    </nav>
  </div>
  <p class="ai">{t.finale.ai}</p>
</footer>

<style>
  .finale { margin: 0 12px; padding: clamp(40px, 5vw, 72px) clamp(16px, 3vw, 48px) clamp(32px, 4vw, 48px); border-radius: 28px; background: radial-gradient(110% 90% at 85% 0%, #2a2a2e 0%, #151517 45%, #0e0e10 100%); color: #fff; display: grid; gap: clamp(40px, 6vw, 80px); }
  .row { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 28px; }
  .mega { margin: 0; font-size: clamp(2.875rem, 8vw, 7rem); font-weight: 700; letter-spacing: -.06em; line-height: .95; }
  .w { display: block; }
  .finale-cta { display: flex; flex-wrap: wrap; gap: 10px; }
  .finale-cta :global(.cta-app) { display: inline-flex; align-items: center; height: 52px; padding: 0 26px; border: 0; border-radius: 999px; background: #fff; color: #0a0a0a; font: inherit; font-weight: 600; font-size: 1rem; white-space: nowrap; cursor: pointer; }
  .finale-cta :global(.cta-ext) { display: inline-flex; align-items: center; gap: 8px; height: 52px; padding: 0 22px; border: 0; border-radius: 999px; background: none; color: #fff; font: inherit; font-weight: 600; font-size: 1rem; text-decoration: none; white-space: nowrap; box-shadow: inset 0 0 0 1px rgba(255,255,255,.22); cursor: pointer; }
  .base { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 32px 48px; padding-top: 32px; border-top: 1px solid rgba(255,255,255,.1); }
  .who { display: grid; gap: 14px; align-content: start; justify-items: start; }
  .who img { width: auto; height: 26px; }
  .who a, nav a { color: #cfcfcf; font-size: .9375rem; text-decoration: none; transition: color .2s; }
  .who a:hover, nav a:hover { color: #fff; }
  nav { display: flex; flex-wrap: wrap; gap: 32px clamp(32px, 6vw, 80px); }
  nav div { display: grid; gap: 10px; align-content: start; }
  nav a { display: block; }
  nav p { margin: 0 0 4px; font-family: var(--font-mono); font-size: 10px; font-weight: 500; letter-spacing: .2em; text-transform: uppercase; color: #8a8a8a; }
  .ai { margin: calc(-1 * clamp(16px, 3vw, 40px)) 0 0; color: #8a8a8a; font-size: .8125rem; }
</style>
