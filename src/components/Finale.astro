---
import { Image } from 'astro:assets';
import GetLink from './GetLink.astro';
import NotifyForm from './NotifyForm.astro';
import { LINKS } from '../data/site';
import logo from '../assets/brand/logo-white.png';
import { COPY } from '../i18n/copy';
import { LANGS, localize, type Lang } from '../i18n/lang';

interface Props { lang: Lang; path: string }
const { lang, path } = Astro.props;
const t = COPY[lang];
const other = LANGS.find((l) => l !== lang) ?? lang;
// Links are written for the root ("/#how", "/legal") and land on the same language's page.
const href = (link: string) => { const [page, hash] = link.split('#'); return localize(lang, page || '/') + (hash ? `#${hash}` : ''); };
const year = new Date().getFullYear();
---
<footer class="finale" id="get" data-tone="dark">
  <div class="cta">
    <h2 class="mega">{t.finale.mega.map((w) => <span class="w">{w}</span>)}</h2>
    <div class="join">
      <p class="lede">{t.finale.notify}</p>
      <NotifyForm lang={lang} dark />
      <GetLink kind="extension" class="xchip"><svg viewBox="0 0 24 24" aria-hidden="true" width="16" height="16"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="4"></circle><path d="M21.17 8H12"></path><path d="M3.95 6.06 8.54 14"></path><path d="M10.88 21.94 15.46 14"></path></svg>{t.finale.extension}{!LINKS.extensionUrl && <span>{t.finale.soon}</span>}</GetLink>
    </div>
  </div>
  <div class="links">
    <Image class="logo" src={logo} height={24} densities={[1, 2]} alt="DressYou" />
    <nav class="cols" aria-label={t.finale.footer}>
      {t.finale.columns.map(({ label, links }) => (
        <div><p>{label}</p>{links.map(([text, link]) => <a href={href(link)}>{text}</a>)}</div>
      ))}
      <div><p>{t.lang.heading}</p><a href={localize(other, path)} hreflang={other} lang={other}>{t.lang.switchTo}</a></div>
    </nav>
  </div>
  <p class="base"><span>© {year} DressYou Technologies</span><span>47 rue Vivienne, 75002 Paris</span><a href={`mailto:${LINKS.email}`}>{LINKS.email}</a></p>
</footer>

<style>
  /* Top room clears the fixed header when the footer reaches the top of the screen. */
  .finale { margin: 0 12px 12px; padding: clamp(104px, 13svh, 136px) clamp(20px, 4vw, 56px) clamp(22px, 3svh, 30px); border-radius: 28px; background: radial-gradient(120% 80% at 50% 0%, #2a2a2e 0%, #151517 48%, #0e0e10 100%); color: #fff; display: grid; gap: clamp(48px, 8svh, 88px); box-shadow: inset 0 0 0 1px rgba(255,255,255,.08); }

  /* The call to sign up. Phones and tablets: all centred. Desktops: the headline on the left, the sign-up on the right. */
  .cta { display: grid; justify-items: center; gap: 24px; width: min(100%, 560px); margin: 0 auto; text-align: center; }
  .join { display: grid; justify-items: center; gap: 18px; width: 100%; }
  .mega { margin: 0; font-size: clamp(2.75rem, 8vw, 6.5rem); font-weight: 700; letter-spacing: -.06em; line-height: .95; }
  .w { display: block; }
  .lede { margin: 0; color: #cfcfcf; font-size: 1.0625rem; line-height: 1.4; }
  @media (min-width: 900px) {
    .cta { grid-template-columns: minmax(0, 1fr) minmax(0, clamp(340px, 40vw, 520px)); align-items: end; gap: clamp(40px, 5vw, 72px); width: 100%; justify-items: stretch; text-align: left; }
    .mega { font-size: clamp(2.75rem, 6.4vw, 6.5rem); }
    .join { justify-items: start; gap: 20px; padding-bottom: 6px; }
    .lede { font-size: 1.25rem; }
    .join :global(.wrap) { justify-items: start; gap: 14px; }
    .join :global(.fine), .join :global(.status) { text-align: left; }
  }
  .cta :global(.xchip) { display: inline-flex; align-items: center; gap: 8px; height: 36px; margin-top: 4px; padding: 0 14px 0 12px; border: 0; border-radius: 999px; background: none; color: #cfcfcf; font: inherit; font-size: .875rem; font-weight: 600; text-decoration: none; box-shadow: inset 0 0 0 1px rgba(255,255,255,.16); cursor: pointer; transition: color .2s, box-shadow .2s; }
  .cta :global(.xchip:hover) { color: #fff; box-shadow: inset 0 0 0 1px rgba(255,255,255,.4); }
  .cta :global(.xchip svg) { fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .cta :global(.xchip span) { font-family: var(--font-mono); font-size: 9px; font-weight: 500; letter-spacing: .16em; text-transform: uppercase; color: #8a8a8a; }

  /* The logo, then the link columns, on one grid line. */
  .links { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 3fr); gap: 32px; align-items: start; padding-top: 36px; border-top: 1px solid rgba(255,255,255,.1); }
  .links :global(.logo) { width: auto; height: 24px; }
  .cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px 24px; }
  .cols div { display: grid; gap: 10px; align-content: start; }
  .cols p { margin: 0 0 4px; font-family: var(--font-mono); font-size: 10px; font-weight: 500; letter-spacing: .2em; text-transform: uppercase; color: #8a8a8a; }
  .cols a, .base a { color: #cfcfcf; font-size: .9375rem; text-decoration: none; transition: color .2s; }
  .cols a:hover, .base a:hover { color: #fff; }
  .base { display: flex; flex-wrap: wrap; gap: 6px 22px; margin: 0; padding-top: 22px; border-top: 1px solid rgba(255,255,255,.08); color: #8a8a8a; font-size: .8125rem; }
  .base a { font-size: .8125rem; }

  /* Tablets: the logo above the columns. Phones: everything centred, the columns two by two. */
  @media (max-width: 899.98px) {
    .links { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 599.98px) {
    .finale { padding-inline: 20px; }
    .links { justify-items: center; text-align: center; }
    .cols { grid-template-columns: repeat(2, minmax(0, 1fr)); width: 100%; gap: 28px 16px; }
    .base { flex-direction: column; align-items: center; gap: 6px; text-align: center; }
  }
</style>
