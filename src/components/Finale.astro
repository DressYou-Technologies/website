---
import { LINKS } from '../data/site';
import lockup from '../assets/brand/lockup-white.svg';
import { COPY } from '../i18n/copy';
import { localize, type Lang } from '../i18n/lang';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = COPY[lang];
// Links are written for the root ("/#how", "/legal") and land on the same language's page.
const href = (link: string) => { const [page, hash] = link.split('#'); return localize(lang, page || '/') + (hash ? `#${hash}` : ''); };
const year = new Date().getFullYear();
---
<footer class="finale" data-tone="dark">
  <nav class="cols" aria-label={t.finale.footer}>
    {t.finale.columns.map(({ label, links }) => (
      <div><p>{label}</p>{links.map(([text, link]) => <a href={href(link)}>{text}</a>)}</div>
    ))}
    <div><p>{t.finale.contact}</p><a href={`mailto:${LINKS.email}`}>{LINKS.email}</a></div>
  </nav>
  <div class="sign">
    <img class="lockup" src={lockup.src} width={lockup.width} height={lockup.height} alt="DressYou" loading="lazy" decoding="async" />
    <p class="base">© {year} DressYou Technologies. {t.finale.rights}</p>
  </div>
</footer>

<style>
  .finale { margin: 0 12px 12px; padding: clamp(48px, 8 * var(--svh), 88px) clamp(20px, 4vw, 56px) clamp(22px, 3 * var(--svh), 30px); border-radius: 28px; background: radial-gradient(120% 80% at 50% 0%, #2a2a2e 0%, #151517 48%, #0e0e10 100%); color: #fff; display: grid; gap: clamp(48px, 8 * var(--svh), 88px); box-shadow: inset 0 0 0 1px rgba(255,255,255,.08); }

  /* The footer, arranged like Versine's (founder, 2026-11-16): the pages in columns, each under a bold title one size above
     its lighter links, then the logo across the card, fading into it, and the rights line. No rule between them. */
  .cols { display: flex; flex-wrap: wrap; gap: 32px clamp(48px, 9vw, 128px); }
  .cols div { display: grid; gap: 10px; align-content: start; }
  .cols p { margin: 0 0 6px; color: #fff; font-size: 1.0625rem; font-weight: 700; letter-spacing: -.01em; }
  .cols a { color: #cfcfcf; font-size: .9375rem; text-decoration: none; transition: color .2s; }
  @media (hover: hover) { .cols a:hover { color: #fff; } }
  /* Touch: the footer links are 44px rows, to tap without aiming (Apple HIG). */
  @media (pointer: coarse) {
    .cols div { gap: 0; }
    .cols a { padding-block: calc((44px - 1lh) / 2); }
  }
  .sign { display: grid; gap: clamp(16px, 2.4vw, 32px); }
  /* The logo sinks into the card: whole at its top, gone just under the letters' baseline (77% down the image), so no
     half-faded foot shows (founder, 2026-11-16). */
  .lockup { --fade: linear-gradient(to bottom, #000, transparent 80%); width: 100%; height: auto; -webkit-mask-image: var(--fade); mask-image: var(--fade); }
  .base { margin: 0; color: #8a8a8a; font-size: .8125rem; }

  @media (max-width: 599.98px) {
    .finale { padding-inline: 20px; }
  }
</style>
