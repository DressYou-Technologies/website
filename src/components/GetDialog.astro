---
import { Image, Picture } from 'astro:assets';
import appIcon from '../assets/brand/app-icon.png';
import { HOW, LINKS } from '../data/site';
import { image } from '../lib/image';
import { qrSvg } from '../lib/qr';
import { COPY } from '../i18n/copy';
import { localize, type Lang } from '../i18n/lang';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = COPY[lang].dialog, get = COPY[lang].get;

// The extension demo tries on the shop scene's last page: the trench.
const last = HOW.shop.pages.length - 1, page = HOW.shop.pages[last];
const [pageName, pagePrice] = COPY[lang].how.shopPages[last];
---
<dialog id="get-app" class="get" aria-labelledby="get-app-title">
  <div class="card">
    <form method="dialog"><button class="close" aria-label={t.close}><svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18"><path d="M18 6 6 18M6 6l12 12"></path></svg></button></form>
    {LINKS.appUrl
      ? <><h2 class="title" id="get-app-title">{t.appReady}</h2><div class="qr" role="img" aria-label={get.qr} set:html={qrSvg(LINKS.appUrl)} /></>
      : <>
          <h2 class="title" id="get-app-title">{t.notify.title}</h2>
          <p class="lede">{t.notify.lede}</p>
          <form class="notify" novalidate data-lang={lang} data-ok={t.says.ok} data-email={t.says.email} data-closed={t.says.closed} data-failed={t.says.failed}>
            <label class="field"><span class="sr">{t.notify.email}</span><input type="email" name="email" required autocomplete="email" inputmode="email" maxlength="254" placeholder={t.notify.placeholder} /></label>
            <input class="trap" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <button class="cta" type="submit">{t.notify.submit}</button>
            <p class="status" role="status" aria-live="polite"></p>
          </form>
          <p class="fine">{t.notify.fine} <a href={localize(lang, '/privacy')}>{t.notify.privacy}</a></p>
        </>}
  </div>
</dialog>

<dialog id="get-extension" class="get wide" aria-labelledby="get-extension-title">
  <div class="card">
    <form method="dialog"><button class="close" aria-label={t.close}><svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18"><path d="M18 6 6 18M6 6l12 12"></path></svg></button></form>
    <h2 class="title" id="get-extension-title">{t.extension.title}</h2>
    <p class="lede">{t.extension.lede}</p>
    <div class="xdemo" aria-hidden="true">
      <div class="xbar"><i></i><i></i><i></i><span class="xurl">{page.domain}</span><span class="xext"><Image src={appIcon} width={22} height={22} densities={[1, 2]} alt="" /><span class="xring"></span></span></div>
      <div class="xpage">
        <div class="xshot"><Picture src={image(page.image)} formats={['avif', 'webp']} widths={[240, 480]} sizes="200px" alt="" loading="lazy" /></div>
        <div class="xinfo"><b>{pageName}</b><span>{pagePrice}</span><span class="xsizes">{['XS', 'S', 'M', 'L'].map((s) => <i>{s}</i>)}</span><span class="xbag">{t.extension.bag}</span></div>
      </div>
      <div class="xpanel">
        <div class="xhead"><Image src={appIcon} width={18} height={18} densities={[1, 2]} alt="" /><b>DressYou</b></div>
        <div class="xtwin"><Picture class="cutout" src={image(HOW.shop.render)} formats={['avif', 'webp']} widths={[200, 400]} sizes="150px" alt="" loading="lazy" /></div>
        <div class="xsize"><span class="xletter">M</span><span><b>{t.extension.fit}</b><span>{t.extension.usual}</span></span></div>
      </div>
    </div>
    {LINKS.extensionUrl
      ? <a class="cta" href={LINKS.extensionUrl} target="_blank" rel="noopener">{t.extension.add}</a>
      : <span class="cta soon" aria-disabled="true">{t.extension.soon}</span>}
  </div>
</dialog>

<style>
  .get { width: min(400px, calc(100% - 40px)); padding: 0; border: 0; border-radius: 28px; background: linear-gradient(180deg, #fff, #efefef); color: #0a0a0a; box-shadow: 0 40px 100px rgba(0,0,0,.35); text-align: center; }
  .get.wide { width: min(560px, calc(100% - 32px)); }
  /* The card fills the dialog box, so a click on the dialog element itself is a click on the backdrop. */
  .card { display: grid; justify-items: center; gap: 16px; padding: 40px 32px 32px; }
  .get::backdrop { background: rgba(0,0,0,.55); backdrop-filter: blur(8px); }
  .close { position: absolute; top: 14px; right: 14px; width: 40px; height: 40px; padding: 0; border: 0; border-radius: 50%; background: rgba(10,10,10,.06); color: #0a0a0a; display: grid; place-items: center; cursor: pointer; }
  .close:hover { background: rgba(10,10,10,.12); }
  .close svg { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; }
  .title { margin: 0; padding-bottom: .08em; font-size: 2.25rem; font-weight: 700; letter-spacing: -.05em; line-height: 1; -webkit-mask-image: linear-gradient(to top, #000 var(--m, 100%), rgba(0,0,0,0) calc(var(--m, 100%) + 40%)); mask-image: linear-gradient(to top, #000 var(--m, 100%), rgba(0,0,0,0) calc(var(--m, 100%) + 40%)); }
  .lede { margin: -4px 0 0; max-width: 30ch; color: rgba(10,10,11,.62); font-size: 1rem; line-height: 1.45; text-wrap: balance; }
  .qr { width: 216px; height: 216px; margin-top: 8px; padding: 14px; }
  .qr :global(svg) { width: 100%; height: 100%; display: block; }
  .cta { display: inline-flex; align-items: center; justify-content: center; height: 52px; padding: 0 26px; border: 0; border-radius: 18px; background: #0a0a0a; color: #fff; font: inherit; font-size: 1rem; font-weight: 700; white-space: nowrap; cursor: pointer; text-decoration: none; }
  .cta.soon { background: rgba(10,10,10,.08); color: rgba(10,10,11,.62); cursor: default; }
  .cta:disabled { opacity: .6; cursor: progress; }

  .notify { display: grid; gap: 10px; width: 100%; margin-top: 6px; }
  .field input { width: 100%; height: 52px; padding: 0 18px; border: 0; border-radius: 16px; background: #fff; box-shadow: inset 0 0 0 1px rgba(10,10,10,.14); color: #0a0a0a; font: inherit; font-size: 1rem; }
  .field input:focus-visible { outline: none; box-shadow: inset 0 0 0 2px #0a0a0a; }
  .sr, .trap { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .status { min-height: 1.4em; margin: 0; font-size: .9375rem; color: rgba(10,10,11,.62); }
  .status.error { color: #b3261e; }
  .notify.done .field, .notify.done .cta { display: none; }
  .notify.done .status { color: #0a0a0a; font-weight: 600; }
  .fine { margin: 0; max-width: 34ch; color: rgba(10,10,11,.5); font-size: .8125rem; line-height: 1.45; }

  /* The extension demo: a product page in Chrome, the DressYou button in the toolbar, the twin and the size beside it. */
  .xdemo { position: relative; width: 100%; aspect-ratio: 16 / 10.5; margin: 4px 0 6px; border-radius: 16px; overflow: hidden; background: #fff; box-shadow: 0 0 0 1px rgba(10,10,10,.1), 0 18px 40px rgba(0,0,0,.14); text-align: left; }
  .xbar { display: flex; align-items: center; gap: 6px; height: 36px; padding: 0 10px; background: #f1f1ef; box-shadow: 0 1px 0 rgba(10,10,10,.08); }
  .xbar > i { width: 9px; height: 9px; border-radius: 50%; background: rgba(10,10,10,.16); }
  .xurl { flex: 1; height: 22px; margin: 0 8px; padding: 0 10px; border-radius: 11px; background: #fff; display: flex; align-items: center; font-family: var(--font-mono); font-size: 10px; color: #6b6b6b; }
  .xext { position: relative; display: grid; place-items: center; width: 26px; height: 26px; }
  .xext :global(img) { width: 22px; height: 22px; border-radius: 6px; }
  .xring { position: absolute; inset: -4px; border-radius: 50%; box-shadow: 0 0 0 2px #0a0a0a; opacity: 0; }
  .xpage { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; height: calc(100% - 36px); padding: 14px; }
  .xshot { position: relative; border-radius: 10px; overflow: hidden; background: #ececea; }
  .xshot :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .xinfo { display: grid; align-content: start; gap: 8px; padding-top: 6px; }
  .xinfo b { font-size: 15px; letter-spacing: -.02em; }
  .xinfo > span { font-size: 13px; font-weight: 600; }
  .xsizes { display: flex; gap: 5px; }
  .xsizes i { width: 28px; height: 24px; border-radius: 7px; box-shadow: inset 0 0 0 1px rgba(10,10,10,.14); display: grid; place-items: center; font-size: 10px; font-style: normal; font-weight: 600; }
  .xbag { display: grid; place-items: center; height: 34px; margin-top: 6px; border-radius: 10px; background: #0a0a0a; color: #fff; font-size: 12px; }
  .xpanel { position: absolute; top: 44px; right: 8px; bottom: 8px; width: 42%; display: grid; grid-template-rows: auto 1fr auto; gap: 8px; padding: 10px; border-radius: 14px; background: rgba(250,250,248,.94); box-shadow: 0 0 0 1px rgba(255,255,255,.8), inset 0 1px 0 #fff, 0 16px 40px rgba(0,0,0,.2); backdrop-filter: blur(14px); }
  .xhead { display: flex; align-items: center; gap: 6px; font-size: 12px; }
  .xhead :global(img) { width: 18px; height: 18px; border-radius: 5px; }
  .xtwin { position: relative; border-radius: 10px; overflow: hidden; }
  .xtwin :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .xsize { display: flex; align-items: center; gap: 8px; padding: 6px 8px 6px 6px; border-radius: 11px; background: #fff; box-shadow: inset 0 0 0 1.5px #0a0a0a; }
  .xletter { width: 26px; height: 26px; border-radius: 8px; background: #0a0a0a; color: #fff; display: grid; place-items: center; font-size: 13px; font-weight: 700; }
  .xsize b { display: block; font-size: 11px; }
  .xsize b + span { display: block; font-family: var(--font-mono); font-size: 7.5px; letter-spacing: .1em; text-transform: uppercase; color: #6b6b6b; }
</style>
