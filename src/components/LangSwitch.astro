---
import { COPY } from '../i18n/copy';
import { LANGS, localize, type Lang } from '../i18n/lang';

// The two languages: the current one, and a link to this page in the other. It sits in the header on wide screens and in
// the menu on phones (founder, 2026-11-17), white on dark in both.
interface Props { lang: Lang; path: string; class?: string }
const { lang, path, class: className } = Astro.props;
---
<div class:list={['langs', className]}>{LANGS.map((l, k) => <>
  {k > 0 && <span class="slash" aria-hidden="true">/</span>}
  {l === lang
    ? <span class="on" aria-current="true">{l.toUpperCase()}</span>
    : <a href={localize(l, path)} hreflang={l} lang={l} aria-label={`${l.toUpperCase()}. ${COPY[lang].lang.label}`}>{l.toUpperCase()}</a>}
</>)}</div>

<style>
  .langs { display: flex; align-items: center; gap: 8px; font-size: .9375rem; font-weight: 700; letter-spacing: -.01em; }
  .langs a, .langs span { padding: 4px 2px; color: inherit; text-decoration: none; }
  /* The other language: dimmer than the current one yet 4.5:1 on the header and the menu (WCAG 1.4.3), 44px to tap through
     its ::before. */
  .langs a { position: relative; opacity: .6; transition: opacity .2s; }
  .langs a::before { content: ''; position: absolute; inset: -10px -8px; }
  @media (hover: hover) { .langs a:hover { opacity: 1; } }
  .langs .slash { padding: 0; opacity: .3; }
</style>
