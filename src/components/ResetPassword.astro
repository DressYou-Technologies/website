---
import Doc from '../layouts/Doc.astro';
import { COPY } from '../i18n/copy';
import type { Lang } from '../i18n/lang';

// Where the reset mail lands. Every state is written here, hidden; src/scripts/auth.ts shows the one the link asks for.
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = COPY[lang].reset;
---
<Doc lang={lang} title={t.title} path="/auth/reset" noindex nofollow>
  <noscript><p>{t.noscript}</p></noscript>
  <section data-state="form" hidden>
    <p>{t.lede}</p>
    <form class="reset" novalidate data-saving={t.saving} data-short={t.short} data-long={t.long} data-busy={t.busy} data-unconfirmed={t.unconfirmed}>
      <label for="new-password">{t.label}</label>
      <input id="new-password" name="newPassword" type="password" autocomplete="new-password" required aria-describedby="password-hint password-status">
      <p id="password-hint" class="hint">{t.hint}</p>
      <button type="submit">{t.save}</button>
      <p id="password-status" class="status" role="status"></p>
    </form>
  </section>
  <section data-state="done" hidden><p tabindex="-1">{t.done}</p></section>
  <section data-state="invalid" hidden><p tabindex="-1">{t.invalid}</p></section>
  <section data-state="missing" hidden><p tabindex="-1">{t.missing}</p></section>
</Doc>

<script>
  import { startReset } from '../scripts/auth';
  startReset();
</script>

<style>
  .reset { display: grid; gap: 10px; max-width: 420px; margin-top: 24px; }
  label { font-weight: 700; }
  input { width: 100%; height: 52px; padding: 0 18px; border: 0; border-radius: 16px; background: #fff; box-shadow: inset 0 0 0 1px rgba(10,10,10,.55); color: var(--ink); font: inherit; font-size: 1rem; }
  input[aria-invalid="true"] { box-shadow: inset 0 0 0 2px #b3261e; }
  input:focus-visible, button:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .reset .hint, .reset .status { margin: 0; font-size: .9375rem; }
  button { justify-self: start; height: 52px; padding: 0 26px; border: 0; border-radius: 18px; background: var(--ink); color: #fff; font: inherit; font-size: 1rem; font-weight: 700; cursor: pointer; }
  button[aria-disabled="true"] { opacity: .6; cursor: progress; }
  .reset .status.error { color: #b3261e; }
  [tabindex="-1"]:focus { outline: none; }
</style>
